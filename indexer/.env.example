# Stellar Pubnet RPC. Defaults to the public forno endpoint (Horizon/Mercury.config.ts);
# set a dedicated provider (Alchemy/QuickNode) for faster backfill in production.
Horizon/Mercury_RPC_URL_42220=

# (Optional) Postgres connection string. Without it Horizon/Mercury uses embedded PGlite —
# fine for dev; use Postgres for production deploys.
DATABASE_URL=
